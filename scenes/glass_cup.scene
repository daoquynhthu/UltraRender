# Glass Cup Physics Demo
resolution 1280 720
spp 32

# Physics Configuration
# dt = 1/60 = 0.01666
physics enabled 1 dt 0.01666 frames 180 spp 32

# Fluid Configuration
# Filling the bottom half of the cup
# Reduced fill bounds to [-0.8, 0.8] to leave margin from walls (walls are at +/- 0.95)
# Fill Height: -0.8 to 0.0 (Bottom of cup is -0.9, Top of fluid is 0.0)
# Metal Sphere is at Y=2.0, Radius=0.4 (Bottom=1.6). This is SAFE.
# Width: -0.8 to 0.8. Cup walls start at -0.95 and 0.95. This is SAFE.
fluid enabled 1 spacing 0.04 bounds -5 -5 -5 5 5 5 fill -0.8 -0.9 -0.8 0.8 0.0 0.8

# Camera
camera pos 0 8 5 lookat 0 0 0 fov 40

# Materials
define_material mat_ground lambertian 0.5 0.5 0.5
define_material mat_glass dielectric 1.0 1.0 1.0 0.0 1.5
define_material mat_water dielectric 0.20 0.50 0.90 0.0 1.33 0.015
# Red material for fluid visibility debug
define_material mat_fluid_red lambertian 0.9 0.1 0.1
define_material mat_metal metal 1.0 0.85 0.5 0.05 0.17 3.1 2.7 1.9
define_material mat_wood lambertian 0.6 0.4 0.2
define_material mat_light light 15 15 15

# Entities

# Ground
# Scale 10 0.1 10 -> Size 10 0.1 10 -> Half-extents 5 0.05 5
add_entity cube mat_ground 0 -1.1 0 10 0.1 10 0 0 0 mass 0 collider box 5 0.05 5 friction 0.5 restitution 0.5

# Cup (Constructed from 5 plates to match physics colliders)
# Thickness reduced to 0.05m (5cm) for realistic glass
# Inner volume width ~1.9m (approx)

# Bottom Plate
# Top face at -0.9. Center = -0.9 - 0.025 = -0.925. Height 0.05.
add_entity cube mat_glass 0 -0.925 0 2.2 0.05 2.2 0 0 0 mass 0 collider box 1.1 0.025 1.1 restitution 0.5

# Left Wall (-x)
# Inner face at -0.95. Center = -0.95 - 0.025 = -0.975. Width 0.05.
add_entity cube mat_glass -0.975 0 0 0.05 2.0 2.2 0 0 0 mass 0 collider box 0.025 1.0 1.1 restitution 0.5

# Right Wall (+x)
# Inner face at 0.95. Center = 0.95 + 0.025 = 0.975. Width 0.05.
add_entity cube mat_glass 0.975 0 0 0.05 2.0 2.2 0 0 0 mass 0 collider box 0.025 1.0 1.1 restitution 0.5

# Front Wall (+z)
# Inner face at 0.95. Center = 0.95 + 0.025 = 0.975. Depth 0.05.
add_entity cube mat_glass 0 0 0.975 2.2 2.0 0.05 0 0 0 mass 0 collider box 1.1 1.0 0.025 restitution 0.5

# Back Wall (-z)
# Inner face at -0.95. Center = -0.95 - 0.025 = -0.975. Depth 0.05.
add_entity cube mat_glass 0 0 -0.975 2.2 2.0 0.05 0 0 0 mass 0 collider box 1.1 1.0 0.025 restitution 0.5

# Falling Sphere (Metal)
# Radius 0.4 -> Scale 0.8
add_entity sphere mat_metal 0.0 2.0 0.0 0.8 0.8 0.8 0 0 0 mass 5.0 collider sphere 0.4 friction 0.2 restitution 0.6 damping 0.99

# Light
add_entity sphere mat_light 0 10 5 2 2 2
