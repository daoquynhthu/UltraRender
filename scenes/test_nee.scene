# NEE Test Scene
resolution 2560 1600
spp 500

# Camera
camera pos 0 3 6 lookat 0 0.5 0 fov 40

# Materials
define_material mat_floor lambertian 0.8 0.8 0.8
define_material mat_light light 20 20 20
define_material mat_rough_metal metal 0.9 0.6 0.2 0.3
define_material mat_glass dielectric 1.0 1.0 1.0 0.0 1.5 0.0

# Geometry
# Floor
add_entity sphere mat_floor 0 -100.5 -1 100 100 100

# Light
add_entity sphere mat_light 0 4 0 0.5 0.5 0.5

# Objects
# Rough Metal Sphere (Should use NEE)
add_entity sphere mat_rough_metal -1.5 0.5 0 1 1 1

# Glass Sphere (Should NOT use NEE, but MIS for transmission/reflection)
add_entity sphere mat_glass 1.5 0.5 0 1 1 1

# Center Diffuse Sphere
add_entity sphere mat_floor 0 0.5 2 0.5 0.5 0.5
