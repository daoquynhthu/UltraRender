# High Poly Stress Test
camera pos 0 5 5 lookat 0 0 0 fov 45

define_material mat_light light 30.0 30.0 30.0
define_material mat_gold metal 0.8 0.6 0.2 0.1
define_material mat_glass dielectric 1.0 1.0 1.0 0.0 1.5 0.02
define_material mat_floor lambertian 0.8 0.8 0.8

# Light
add_entity sphere mat_light 0 10 0 5 5 5

# High Poly Spheres (Mesh)
# 500x250 = 125k quads = 250k tris per sphere
# Total 500k triangles in scene
add_entity highpoly_sphere mat_gold -1.2 0 0 2 2 2 0 0 0 500 250
add_entity highpoly_sphere mat_glass 1.2 0 0 2 2 2 0 0 0 500 250

# Floor
add_entity quad mat_floor 0 -1 0 10 10 10 -90 0 0
