# Glass Collision Acoustic Test
resolution 1280 720
spp 32

# Physics Configuration
# dt = 1/60 = 0.01666
physics enabled 1 dt 0.01666 frames 120 spp 32

# Disable fluid for this test
fluid enabled 0

# Camera
camera pos 0 5 10 lookat 0 0 0 fov 40

# Materials
define_material mat_ground lambertian 0.5 0.5 0.5
define_material mat_glass dielectric 1.0 1.0 1.0 0.0 1.5
define_material mat_light light 15 15 15

# Entities

# Ground (Frictionless ice)
# Box Size Y=0.1 (Scale 0.1 on Cube size 2 = 0.2? No, Cube size is 2. Scale 0.1 -> 0.2. Half extent 0.1)
# Wait, let's stick to collider size. Collider box 5 0.05 5 -> Full size 10 x 0.1 x 10.
# If center is -0.05, top is 0.0.
add_entity cube mat_ground 0 -0.05 0 10 0.1 10 0 0 0 mass 0 collider box 5 0.05 5 restitution 0.5 friction 0.0

# Sphere 1 (Left, moving right)
# velocity 2 0 0
add_entity sphere mat_glass -2.0 0.5 0.0 1 1 1 0 0 0 mass 1.0 collider sphere 0.5 restitution 0.9 friction 0.0 linear_damping 0.0 velocity 2.5 0 0 material_id 3

# Sphere 2 (Right, moving left)
# velocity -2 0 0
add_entity sphere mat_glass 2.0 0.5 0.0 1 1 1 0 0 0 mass 1.0 collider sphere 0.5 restitution 0.9 friction 0.0 linear_damping 0.0 velocity -2.5 0 0 material_id 3

# Light
add_entity sphere mat_light 0 10 5 2 2 2
