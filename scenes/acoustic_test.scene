# Acoustic Test Scene
resolution 640 480
spp 32

camera pos 0 5 15 lookat 0 2 0 fov 45

# Physics
physics enabled 1 dt 0.016 frames 150 spp 32

# Materials
# define_material <name> <type> [params...]
# material_id: 0=Default, 1=Metal, 2=Wood, 3=Glass

# Floor (Wood-like absorption)
define_material floor_mat lambertian 0.8 0.8 0.8

# Wall (Concrete/Wood - Obstacle)
define_material wall_mat lambertian 0.8 0.2 0.2

# Glass Sphere (Source)
define_material glass_mat dielectric 1.0 1.0 1.0 0.0 1.5

# Metal Sphere (Source 2)
define_material metal_mat metal 0.9 0.9 0.9 0.1 1.0 1.0 1.0

# Geometry

# Floor (Static)
# Pos: 0 -1 0, Scale: 20 1 20
add_entity cube floor_mat 0 -1 0 20 1 20 mass 0 collider box 10 0.5 10 material_id 2

# Wall (Glass Block - Refraction/Transmission Test)
# Pos: 0 2 0, Scale: 4 4 0.5
add_entity cube glass_mat 0 2 0 4 4 0.5 mass 0 collider box 2 2 0.25 material_id 3

# Glass Sphere (Falling Source)
# Pos: 2 8 -4 (Behind the wall slightly to the right)
add_entity sphere glass_mat 2 8 -4 1 1 1 mass 1.0 restitution 0.8 collider sphere 0.5 material_id 3

# Metal Sphere (Falling Source)
# Pos: -2 8 -4 (Behind the wall slightly to the left)
add_entity sphere metal_mat -2 8 -4 1 1 1 mass 2.0 restitution 0.6 collider sphere 0.5 material_id 1
