# Wavelength Calibration Scene (Spectral Pipeline)
# Center: Red Cube (1.0, 0, 0)
# Sky: Blue (0.2, 0.2, 0.4)
resolution 512 512
camera pos 0 0 5 lookat 0 0 0 fov 40

# Materials
define_material mat_red   lambertian 1.0 0.0 0.0
define_material mat_white  light      5.0 5.0 5.0

# Entities
add_entity cube mat_red 0 0 0 2 2 2
add_entity sphere mat_white 0 10 0 2 2 2
