resolution 2560 1600
spp 1000

camera pos 0 1.4 6.2 lookat 0 1.0 0 fov 35

define_image img_base ..\output\scene_ir_smoke_v7.bmp srgb
define_image img_rough ..\output\validation_textures\roughness_card.bmp linear
define_image img_emit ..\output\validation_textures\emission_card.bmp srgb
define_texture tex_base img_base 0
define_texture tex_rough img_rough 0
define_texture tex_emit img_emit 0

define_material mat_display light 1.0 1.0 1.0 emission_tex tex_base
define_material mat_shaded metal 0.92 0.92 0.92 0.85 0.20 3.00 3.00 3.00 roughness_tex tex_rough
define_material mat_emit light 1.0 1.0 1.0 emission_tex tex_emit
define_material mat_key light 42.0 42.0 42.0

add_entity quad mat_display -2.2 1.0 0 1.6 0.9 1.0 90 0 0
add_entity quad mat_shaded 0 1.0 0 1.6 0.9 1.0 90 0 0
add_entity quad mat_emit 2.2 1.0 0 1.6 0.9 1.0 90 0 0
add_entity sphere mat_key 0 3.2 2.4 0.9 0.9 0.9
