# Physics optics visual validation scene
resolution 640 360
spp 64
camera pos 0 2.2 7 lookat 0 0.85 0 fov 38

define_material mat_ground lambertian 0.74 0.72 0.68 1.0
define_material mat_back lambertian 0.55 0.60 0.68 1.0
define_material mat_smooth_glass dielectric 1.0 1.0 1.0 0.0 1.5 0.0
define_material mat_rough_glass dielectric 1.0 1.0 1.0 0.42 1.5 0.0
define_material mat_rough_gold metal 0.95 0.67 0.28 0.32 0.17 3.1 2.7 1.9
define_material mat_light light 35.0 35.0 35.0

add_entity quad mat_ground 0 0 0 9 1 9
add_entity cube mat_back 0 2.0 -2.8 9 4 0.18

add_entity sphere mat_smooth_glass -1.8 0.72 -0.2 1.35 1.35 1.35
add_entity sphere mat_rough_glass 0 0.72 -0.2 1.35 1.35 1.35
add_entity sphere mat_rough_gold 1.8 0.72 -0.2 1.35 1.35 1.35

add_entity sphere mat_light 0 4.8 1.8 1.4 1.4 1.4
