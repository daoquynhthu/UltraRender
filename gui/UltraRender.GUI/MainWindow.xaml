<Window x:Class="UltraRender.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UltraRender.GUI"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="UltraRender Studio" Height="720" Width="1280" 
        Background="#2D2D30" TextElement.Foreground="#F1F1F1" FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Dark Theme Styles -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High Contrast Menu Item Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Border" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="5,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="13"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                    <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" Margin="5,0,20,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="InputGestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="5,2,0,2" DockPanel.Dock="Right" Foreground="#999999" VerticalAlignment="Center"/>
                                    <Popup x:Name="Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border x:Name="SubmenuBorder" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" Padding="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    </Border>
                                    <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                        <Border x:Name="SubmenuBorder" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" Padding="2">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Margin="0,0,0,5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#2D2D30" Foreground="#F1F1F1" Padding="5">
            <Menu.Resources>
                 <Style TargetType="Separator">
                    <Setter Property="Background" Value="#3E3E42"/>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_New Project..." Click="MenuItem_NewProject_Click"/>
                <MenuItem Header="_Open Project..." Click="MenuItem_OpenProject_Click"/>
                <MenuItem x:Name="menuOpenRecent" Header="Open _Recent"/>
                <Separator Background="#3E3E42"/>
                <MenuItem Header="_Save Project" Click="MenuItem_SaveProject_Click"/>
                <MenuItem Header="Save Project _As..." Click="MenuItem_SaveProjectAs_Click"/>
                <Separator Background="#3E3E42"/>
                <MenuItem Header="_Open Scene..." Command="Open" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Save Scene" Click="MenuItem_SaveScene_Click" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="_Save Image..." Command="Save" InputGestureText="Ctrl+S"/>
                <Separator Background="#3E3E42"/>
                <MenuItem Header="E_xit" Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" IsEnabled="False"/>
                <MenuItem Header="_Redo" IsEnabled="False"/>
                <Separator Background="#3E3E42"/>
                <MenuItem Header="_Preferences"/>
            </MenuItem>
            <MenuItem Header="_Render">
                <MenuItem Header="_Start Rendering" Command="{x:Static local:MainWindow.RenderCommand}" InputGestureText="F5"/>
                <MenuItem Header="S_top Rendering" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Reset View"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <!-- Tools Panel -->
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Viewport -->
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <ColumnDefinition Width="300"/> <!-- Inspector -->
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Settings & Tools -->
            <Grid Grid.Column="0" Background="#252526">
                <TabControl Background="Transparent" BorderThickness="0" Margin="0,5,0,0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,5">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="RENDER SETTINGS">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="15">
                                
                                <TextBlock Text="Output Configuration" Foreground="Gray" Margin="0,0,0,10" FontSize="11"/>
                                <GroupBox Header="Resolution">
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30"/>
                                            <RowDefinition Height="30"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Width" VerticalAlignment="Center" Grid.Row="0"/>
                                        <TextBox x:Name="txtWidth" Text="800" Grid.Column="1" Grid.Row="0" Style="{StaticResource DarkTextBox}" Margin="0,2"/>

                                        <TextBlock Text="Height" VerticalAlignment="Center" Grid.Row="1"/>
                                        <TextBox x:Name="txtHeight" Text="600" Grid.Column="1" Grid.Row="1" Style="{StaticResource DarkTextBox}" Margin="0,2"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Sampling">
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SPP" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtSPP" Text="10" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,2"/>
                                    </Grid>
                                </GroupBox>

                                <Button x:Name="btnRender" Content="RENDER IMAGE" Height="40" Margin="0,20,0,0" 
                                        Background="#007ACC" Foreground="White" FontWeight="Bold" 
                                        Click="BtnRender_Click" Style="{StaticResource DarkButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="SCENE GRAPH" Visibility="Collapsed">
                        <Grid Background="#252526">
                            <TreeView x:Name="treeSceneGraphOld" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Padding="5"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#3E3E42"/>

            <!-- Center Panel: Viewport & Console -->
            <Grid Grid.Column="2" Background="#1E1E1E">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- Viewport Area -->
        <TabControl Grid.Row="0" Background="#111111" BorderThickness="0" Margin="0">
            <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#999999"/>
                            <Setter Property="Background" Value="#333333"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" BorderThickness="0,0,0,0" Background="{TemplateBinding Background}" Padding="15,5" Margin="0,0,1,0">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    
                    <TabItem Header="REAL-TIME RENDER">
                 <Grid x:Name="viewRealtime" Background="#1E1E1E">
                     <gl:GLWpfControl x:Name="glControl" Render="GlControl_Render" Ready="GlControl_Ready" Focusable="True" InputMethod.IsInputMethodEnabled="False"/>
                     <!-- Overlay Info -->
                     <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                     </StackPanel>
                 </Grid>
            </TabItem>
            
            <TabItem Header="ENGINE RENDER">
                <Grid x:Name="viewEngine">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#111111">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,20,20" />
                                            <RectangleGeometry Rect="0,0,10,10" />
                                            <RectangleGeometry Rect="10,10,10,10" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Pen>
                                        <Pen Brush="#151515" Thickness="0"/>
                                    </GeometryDrawing.Pen>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Image x:Name="imgPreview" Stretch="Uniform"/>
                    <TextBlock Text="Path Tracing Output" Foreground="#555555" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
                </Grid>
            </TabItem>
        </TabControl>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#3E3E42"/>

                <!-- Console & Assets -->
                <TabControl Grid.Row="2" Background="#252526" BorderThickness="0" Margin="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Background" Value="#333333"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" BorderThickness="0,0,0,0" Background="{TemplateBinding Background}" Padding="10,5" Margin="0,0,1,0">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#252526"/>
                                                <Setter Property="Foreground" Value="#007ACC"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="CONSOLE">
                         <Grid Background="#252526">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBox x:Name="txtConsole" Grid.Row="0" Background="#1E1E1E" Foreground="#CCCCCC" 
                                     FontFamily="Consolas" FontSize="12" IsReadOnly="True" 
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="5"/>

                            <Grid Grid.Row="1" Background="#333333">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text=">" Foreground="#007ACC" Margin="5,5,5,5" FontWeight="Bold"/>
                                <TextBox x:Name="txtCommandInput" Grid.Column="1" Background="Transparent" Foreground="White" 
                                         BorderThickness="0" Padding="0,5" KeyDown="TxtCommandInput_KeyDown"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="ASSET BROWSER">
                        <Grid Background="#252526">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Asset Filter Tabs -->
                            <TabControl x:Name="tabAssets" Grid.Row="0" SelectionChanged="TabAssets_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="0">
                                <TabControl.Resources>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="10,5">
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.Resources>
                                <TabItem Header="All Assets" Tag=""/>
                                <TabItem Header="Scenes" Tag="scenes"/>
                                <TabItem Header="Textures" Tag="textures"/>
                                <TabItem Header="Models" Tag="models"/>
                                <TabItem Header="Audio" Tag="audio"/>
                                <TabItem Header="Materials" Tag="materials"/>
                                <TabItem Header="Prefabs" Tag="prefabs"/>
                                <TabItem Header="Scripts" Tag="scripts"/>
                            </TabControl>

                            <!-- Asset Grid -->
                            <Grid Grid.Row="1" Background="#1E1E1E">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Toolbar -->
                                <Grid Grid.Row="0" Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtCurrentPath" Text="Project Root" VerticalAlignment="Center" Foreground="#888888"/>
                                    <TextBox x:Name="txtAssetSearch" Grid.Column="1" Style="{StaticResource DarkTextBox}" Tag="Search Assets..." TextChanged="TxtAssetSearch_TextChanged"/>
                                </Grid>

                                <ListBox x:Name="listAssets" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                         Foreground="#FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="ListAssets_MouseDoubleClick"
                                         AllowDrop="True" Drop="ListAssets_Drop">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="90" Height="100" Margin="5" Background="#2D2D30" CornerRadius="3" ToolTip="{Binding FullPath}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- Icon/Preview -->
                                                    <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Color}"/>
                                                    <!-- Name -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" 
                                                               HorizontalAlignment="Center" Margin="2" FontSize="11" Foreground="#DDDDDD"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#3E3E42"/>

            <!-- Right Panel: Hierarchy & Properties -->
            <Grid Grid.Column="4" Background="#252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hierarchy -->
            <GroupBox Header="SCENE HIERARCHY" Grid.Row="0" Margin="5" Foreground="#CCCCCC" BorderBrush="#3E3E42">
                <TreeView x:Name="treeSceneGraph" Background="Transparent" BorderThickness="0" Padding="5" SelectedItemChanged="TreeSceneGraph_SelectedItemChanged">
                     <TreeView.Resources>
                         <Style TargetType="{x:Type TreeViewItem}">
                             <Setter Property="HeaderTemplate">
                                 <Setter.Value>
                                     <DataTemplate>
                                         <StackPanel Orientation="Horizontal">
                                             <TextBlock Text="{Binding}" Margin="2" FontFamily="Segoe UI" FontSize="14" Foreground="White">
                                                 <TextBlock.Effect>
                                                     <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="Black" Opacity="0.5"/>
                                                 </TextBlock.Effect>
                                             </TextBlock>
                                         </StackPanel>
                                     </DataTemplate>
                                 </Setter.Value>
                             </Setter>
                             <Setter Property="Foreground" Value="White"/>
                             <Setter Property="FontSize" Value="14"/>
                             <Setter Property="FontFamily" Value="Segoe UI"/>
                             <Setter Property="Margin" Value="0,2,0,2"/>
                             <Style.Triggers>
                                 <Trigger Property="IsSelected" Value="True">
                                     <Setter Property="Background" Value="#007ACC"/>
                                     <Setter Property="Foreground" Value="White"/>
                                 </Trigger>
                                 <Trigger Property="IsMouseOver" Value="True">
                                     <Setter Property="Background" Value="#3E3E42"/>
                                 </Trigger>
                             </Style.Triggers>
                         </Style>
                     </TreeView.Resources>
                </TreeView>
            </GroupBox>

                <!-- Splitter -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#3E3E42"/>

                <!-- Properties -->
                <GroupBox Header="PROPERTIES" Grid.Row="2" Margin="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelProperties" Margin="5"/>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White" Padding="5,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="statusText" Text="READY" FontWeight="Bold" Margin="0,0,10,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Background="#55FFFFFF"/>
            <StatusBarItem>
                <TextBlock Text="UltraRender Core v0.1"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="GPU: Active"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>