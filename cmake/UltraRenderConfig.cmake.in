@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/UltraRenderTargets.cmake")

set_and_check(UltraRender_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")

set(UltraRender_CUDA_BACKEND_AVAILABLE @UR_ENABLE_CUDA@)
foreach(_UltraRender_component IN LISTS UltraRender_FIND_COMPONENTS)
    if(TARGET UltraRender::${_UltraRender_component})
        set(UltraRender_${_UltraRender_component}_FOUND TRUE)
    else()
        set(UltraRender_${_UltraRender_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(UltraRender)
