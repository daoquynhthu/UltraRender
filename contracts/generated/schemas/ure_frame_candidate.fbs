include "ure_payload_candidate.fbs";

namespace ultrarender.contract.candidate;

table FramePlaneDescriptor {
  semantic_id:uint (id: 0);
  width:uint (id: 1);
  height:uint (id: 2);
  row_stride:ulong (id: 3);
  element_stride:uint (id: 4);
  blob:SharedBlobDescriptor (id: 5);
}

table FrameReadyDescriptor {
  frame_id:ulong (id: 0);
  revision:ulong (id: 1);
  planes:[FramePlaneDescriptor] (id: 2);
  retained_bytes:ulong (id: 3);
}
