namespace ultrarender.contract.preview.v0;

enum ProductMessageKind:uint {
  CreateJob = 2147483688,
  StartJob = 2147483689,
  CancelJob = 2147483690,
  AcquireArtifact = 2147483691,
  AcquireFrame = 2147483704,
  SceneToolValidate = 2147483714,
  SceneToolInspect = 2147483715,
  SceneToolBuild = 2147483716,
  SceneToolMigrate = 2147483717,
  SceneToolPack = 2147483718,
  SceneToolUnpack = 2147483719,
  SceneToolRealize = 2147483720,
  SceneToolMaterialImport = 2147483721,
  SceneToolMaterialExport = 2147483722,
  SceneToolMaterialPreset = 2147483723
}

table SceneToolRequest {
  operation:uint (id: 0);
  input_paths:[string] (id: 1);
  output_path:string (id: 2);
  package_scene_id:string (id: 3);
  max_content_bytes:ulong (id: 4);
  max_uncompressed_bytes:ulong (id: 5);
  max_resident_bytes:ulong (id: 6);
  max_resource_count:ulong (id: 7);
  max_object_count:ulong (id: 8);
  max_nesting_depth:uint (id: 9);
  max_decompression_ratio:uint (id: 10);
  temporary_budget_bytes:ulong (id: 11);
  allow_script_execution:bool = false (id: 12);
  material_selector:string (id: 13);
  preset_name:string (id: 14);
}

table SceneToolResult {
  operation:uint (id: 0);
  disposition_count:uint (id: 1);
  diagnostic_count:uint (id: 2);
  snapshot_identity:[ubyte] (id: 3);
  semantic_identity:[ubyte] (id: 4);
  stored_bytes:ulong (id: 5);
  decompressed_bytes:ulong (id: 6);
  resident_bytes:ulong (id: 7);
  streamed_bytes:ulong (id: 8);
  temporary_bytes:ulong (id: 9);
  scene_count:ulong (id: 10);
  resource_count:ulong (id: 11);
  cache_count:ulong (id: 12);
  dependency_count:ulong (id: 13);
  report:string (id: 14);
  output_bytes:ulong (id: 15);
  material_program_set_identity:[ubyte] (id: 16);
  material_program_count:ulong (id: 17);
  adapter_loss_report_size:ulong (id: 18);
}

table ProductIdentitySet {
  build:[ubyte] (id: 0);
  snapshot:[ubyte] (id: 1);
  objective:[ubyte] (id: 2);
  plan:[ubyte] (id: 3);
}

table ProductExecutionInfo {
  backend:uint (id: 0);
  provider:uint (id: 1);
  runtime_state:uint (id: 2);
  ordinal:uint (id: 3);
  device_identity:[ubyte] (id: 4);
  required_features:ulong (id: 5);
  selected_memory_budget_bytes:ulong (id: 6);
  total_memory_bytes:ulong (id: 7);
  available_memory_bytes:ulong (id: 8);
  name:string (id: 9);
  adapter_id:string (id: 10);
}

table ProductJobRequest {
  scene_id:ulong (id: 0);
  job_id:ulong (id: 1);
  objective:[ubyte] (id: 2);
  objective_schema:uint (id: 3);
  objective_version_major:ushort (id: 4);
  objective_version_minor:ushort (id: 5);
  determinism_policy:uint (id: 6);
  usage_policy:uint (id: 7);
  output_semantics:[uint] (id: 8);
  wall_time_budget_ns:ulong (id: 9);
  memory_budget_bytes:ulong (id: 10);
  sample_budget:ulong (id: 11);
  latency_budget_ns:ulong (id: 12);
  objective_digest:[ubyte] (id: 13);
}

table ProductJobStatus {
  job_id:ulong (id: 0);
  operation_id:ulong (id: 1);
  frame_id:ulong (id: 2);
  state:uint (id: 3);
  requested_samples:ulong (id: 4);
  accepted_samples:ulong (id: 5);
  identities:ProductIdentitySet (id: 6);
  completed_samples:ulong (id: 7);
  execution:ProductExecutionInfo (id: 8);
  progress_sequence:ulong (id: 9);
  stage:uint (id: 10);
  elapsed_ns:ulong (id: 11);
  remaining_min_ns:ulong (id: 12);
  remaining_max_ns:ulong (id: 13);
  latest_frame_generation:ulong (id: 14);
  eligible_integrator_modes:ulong (id: 15);
  qualified_integrator_modes:ulong (id: 16);
  executed_integrator_modes:ulong (id: 17);
}

table ProductArtifactManifest {
  job_id:ulong (id: 0);
  accepted_samples:ulong (id: 1);
  rgb_value_count:ulong (id: 2);
  frame_content:[ubyte] (id: 3);
  identities:ProductIdentitySet (id: 4);
}

table ProductEnvelope {
  kind:ProductMessageKind = CreateJob (id: 0);
  request:ProductJobRequest (id: 1);
  status:ProductJobStatus (id: 2);
  artifact:ProductArtifactManifest (id: 3);
  scene_tool_request:SceneToolRequest (id: 4);
  scene_tool_result:SceneToolResult (id: 5);
}

root_type ProductEnvelope;
file_identifier "URP0";
