{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ure.preview.product-evidence-supersessions/1.0",
  "title": "UltraRender Product Evidence Supersessions",
  "type": "object",
  "required": ["schema", "records"],
  "properties": {
    "schema": {"const": "ure.preview.product-evidence-supersessions/1.0"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "recorded_date", "superseded_report", "superseded_report_sha256", "historical_report_policy", "recovery_gate", "reason_codes", "claims", "evidence_scope"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "recorded_date": {"type": "string", "format": "date"},
          "superseded_report": {"type": "string", "minLength": 1},
          "superseded_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "historical_report_policy": {"const": "Immutable"},
          "recovery_gate": {"const": "PRV.1R"},
          "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["capability_id", "previous_closure", "current_closure"],
              "properties": {
                "capability_id": {"type": "string", "minLength": 1},
                "previous_closure": {"const": "ProductE2E"},
                "current_closure": {"enum": ["RendererIntegrated", "ClientReachable"]}
              },
              "additionalProperties": false
            }
          },
          "evidence_scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
